# Supabase — laissez vide pour utiliser le mode démo (données en mémoire).
# Renseignez ces deux variables pour activer la persistance PostgreSQL + Auth + RLS.
#
# Sur Vercel, vous pouvez aussi utiliser l'intégration Vercel ↔ Supabase :
# l'application accepte alors les variables SUPABASE_URL / SUPABASE_ANON_KEY
# qu'elle injecte (voir vite.config.ts + src/lib/env.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (Optionnel) Compte de test pour `npm run check:supabase`.
# Sans ces valeurs, la vérification utilise une session anonyme.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
